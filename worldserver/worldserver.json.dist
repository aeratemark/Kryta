{
  "note": "worldserver.json.dist - the game program's own configuration. Reference: src/server/apps/worldserver/worldserver.conf.dist, whose setting names these are; the format is this project's (docs/decisions/0005-json-configuration.md). One file per program: this program reads this file and no other. Only the settings the ported stages read are here - a setting arrives with the stage that reads it, so a key in this file is one the program actually uses.",

  "RealmID": {
    "value": 2,
    "doc": "Which world this process is: the id a login hands a client as its map_token, and the id a realmlist row carries. A connection that names another world is closed."
  },

  "WorldServerPort": {
    "value": 6113,
    "doc": "Where gameplay connections are accepted. The login names this address and port in its 0x0009, and the front door copies a client's gameplay connection here."
  },

  "StatusInterval": {
    "value": 30,
    "doc": "How often the program says what it is doing: up time, accepted connections, the maps it hosts and the instances it holds open. The auth program's timer reads the same key."
  },

  "BindIP": {
    "value": "127.0.0.1",
    "doc": "The address the listener binds."
  },

  "Network": {
    "Threads": {
      "value": 1,
      "doc": "Network threads serving accepted connections; a connection goes to the thread with the fewest already."
    },
    "Trace": {
      "value": false,
      "doc": "Every byte of every gameplay connection, in and out, at debug. It needs its logger: Logger.network.trace = 6,Console Server."
    }
  },

  "InventoryFile": {
    "value": "data/inventory.json",
    "doc": "The bags and items a character-creation screen is given - a record list, read at start-up. A client with no items has no inventory model to draw."
  },

  "EquipmentFile": {
    "value": "data/equipment.json",
    "doc": "What a new character wears per campaign and profession - a record list of sets, read at start-up."
  },

  "World": {
    "DistrictAllotment": {
      "value": 100,
      "doc": "How many players one district of an outpost holds before the next district is shown (R5). The allotment is tied to a machine's own efficiency, so it is the operator's number; the game's value is 100."
    },
    "PartySizeCap": {
      "value": 8,
      "doc": "The party cap this world applies when a map does not state its own (R15). 8 is the common cap in the game; some modes allow 12 and some instances 25, and a map row overrides this."
    },
    "SpawnScatter": {
      "value": 250,
      "doc": "How far around a spawn point a character is placed when it enters a map (R13), in the game's own units: every entry picks a random point of that map's list and lands within this radius of it."
    },
    "InstanceTick": {
      "value": true,
      "doc": "Whether an instance keeps a clock at all (R33). The game ticks one; an operator may choose not to, and nothing that does not tick can be simulated."
    },
    "SimulationTickMs": {
      "value": 105,
      "doc": "How often one connection's simulation is ticked (R33), in milliseconds. 105 is the game's measured cadence (one 0x001E every 90-110 ms over 1780 ticks in the reference's own crossing); an operator may run faster or slower."
    },
    "SweepIntervalMs": {
      "value": 1000,
      "doc": "How often the world checks its instance table for copies to dispose (R33, R40), in milliseconds. The reference's own check is not measured; a second is what a fifteen-minute hold needs."
    },
    "CompassRange": {
      "value": 10000,
      "doc": "The range at which an enemy is simulated (R34), in the game's own units. Outside it, enemies are not ticked - most enemies only exist while inside it."
    },
    "ExplorableDisconnectHold": {
      "value": 900,
      "doc": "How long an explorable instance is held for a reconnecting party after a network disconnect (R37), in seconds; 900 is 15 minutes. A party that leaves by any normal means disposes the instance at once, whatever this says (R40)."
    },
    "MissionButton": {
      "value": true,
      "doc": "Whether an outpost that offers a mission presents the 'Enter Mission' button (R56)."
    },
    "AgentHealth": {
      "value": 400,
      "doc": "The health a player agent is created with, sent as agent int-property 42 at load. The game's value for a fresh body is 400."
    },
    "AgentEnergy": {
      "value": 25,
      "doc": "The energy a player agent is created with, sent as agent int-property 41 at load. The game's value for a fresh body is 25."
    },
    "AgentEnergyRegen": {
      "value": 0,
      "doc": "The energy regeneration a player agent is created with, sent as agent float-property 43. Zero is what the reference's own capture shows for a fresh agent."
    },
    "AgentSpeed": {
      "value": 288,
      "doc": "How fast a player agent walks, in units a second: the create message carries it and the client walks the model at it."
    },
    "PublicAddress": {
      "value": "127.0.0.1:6112",
      "doc": "The address a travelling client is told to reconnect to, as host:port - the redirect (0x01A6) carries it as a Winsock sockaddr_in. The working implementation publishes one (its --public argument, ASURA/crates/asura-world/src/main.rs:73). This stack's client dials the address it was launched against, which is the login port, and the front door copies that connection to the world, so the default is that address."
    },
    "MaxAllowedCorrection": {
      "value": 250,
      "doc": "How far, in game units, a client may place itself when it cancels a walk (0x8047) and still be believed. A correction farther than this from where the server thought the agent stood is ignored: the agent stops where the server believes it is and nothing goes on the wire, so the client is never ordered backwards. The reference's MAXIMUM_ALLOWED_CORRECTION (GmAgent.c:547-563); the working implementation runs it at 250 (ASURA/config/Server/movement.json)."
    },
    "Appearance": {
      "value": 51380224,
      "doc": "The packed appearance word a character with no bits of its own is drawn with - 51380224 is 0x03100000, profession 1 (Warrior) with hair style 3, everything else zero. An all-zero word is Profession_None, which the client cannot build a model from."
    }
  },

  "Log": {
    "EffectiveConfig": {
      "value": false,
      "doc": "Every setting this program read from this file, with any database password masked, at debug. It needs its logger: Logger.server.loading = 6,Console Server."
    }
  },

  "PidFile": {
    "value": "",
    "doc": "Written when a PID is wanted for a service manager. Empty writes nothing."
  },

  "LogsDir": {
    "value": "",
    "doc": "Where file appenders write. Empty means the working directory."
  },

  "LoginDatabaseInfo": {
    "value": "127.0.0.1;5432;kryta;change-me;kryta_login",
    "doc": "host;port;user;password;database - the login's own tables: accounts, the world list, and the travel record a login writes and this program claims. The world reads this database the way the reference's world program reads its login database; the two programs never talk to each other."
  },

  "LoginDatabase": {
    "WorkerThreads": {
      "value": 2,
      "doc": "Asynchronous connections to the login database."
    },
    "SynchThreads": {
      "value": 1,
      "doc": "Synchronous connections to it."
    }
  },

  "WorldDatabaseInfo": {
    "value": "127.0.0.1;5432;kryta;change-me;kryta_world",
    "doc": "host;port;user;password;database - the world's own tables, which is what the game is made of rather than what its players did. The fourth field is a password: it is masked in every log line, and this file is not committed with a real one."
  },

  "WorldDatabase": {
    "WorkerThreads": {
      "value": 2,
      "doc": "Asynchronous connections to the world database."
    },
    "SynchThreads": {
      "value": 1,
      "doc": "Synchronous connections, used where the caller cannot wait."
    }
  },

  "CharacterDatabaseInfo": {
    "value": "127.0.0.1;5432;kryta;change-me;kryta_characters",
    "doc": "host;port;user;password;database - characters, their items and their progress. A player's rows, not a designer's."
  },

  "CharacterDatabase": {
    "WorkerThreads": {
      "value": 2,
      "doc": "Asynchronous connections to the character database."
    },
    "SynchThreads": {
      "value": 1,
      "doc": "Synchronous connections to it."
    }
  },

  "Database": {
    "Trace": {
      "value": false,
      "doc": "Every statement both pools run, as a debug line. It needs its logger: Logger.sql.trace = 6,Console Server."
    }
  },

  "Appender": {
    "Console": {
      "value": [1, 4, 0, "1 9 3 6 5 8"],
      "doc": "Type, level, flags, then the type's own fields. Type 1 is the console and its last field is the colour list for fatal, error, warn, info, debug, trace."
    },
    "Server": {
      "value": [2, 5, 0, "Server.log", "w"],
      "doc": "Type 2 is a file: the name, then the mode (a append, w overwrite)."
    },
    "Errors": {
      "value": [2, 2, 0, "Errors.log", "w"],
      "doc": "Errors on their own file, so a service manager can watch one of them."
    }
  },

  "Logger": {
    "root": {
      "value": [2, "Console Server"],
      "doc": "Level, then appender names. A logger inherits from its dotted parent and finally from root."
    },
    "server": {
      "value": [4, "Console Server"],
      "doc": "The program's own lines."
    },
    "sql": {
      "value": [4, "Console Server"],
      "doc": "Database statements."
    },
    "sql.sql": {
      "value": [2, "Console Errors"],
      "doc": "Database failures, on the error appender."
    },
    "sql.updates": {
      "value": [4, "Console Server Errors"],
      "doc": "The schema updater, on both."
    },
    "time.update": {
      "value": [4, "Console Server"],
      "doc": "The clock the world advances by."
    }
  }
}
